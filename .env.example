# Server
PORT=3000
MCP_BEARER_TOKEN=change-me-to-a-long-random-string
DB_PATH=./data/acme-remit.db
TICKER_MS=15000

# Rates (Frankfurter, ECB mid-market; no key needed). ECB has no AED: AED/INR = USD/INR / 3.6725 (peg)
RATES_URL=https://api.frankfurter.dev/v1

# AWS / Bedrock (simulator only; never used inside tool handlers)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
# AWS credentials come from the standard chain (env, profile, or instance role); do not put keys here.

# Simulator (/sim/*) and recording controls (/dev/*). Leave a code unset to disable that surface.
SIM_ACCESS_CODE=change-me-sim-code
DEV_CONTROLS_CODE=change-me-dev-code
SIM_DAILY_BEDROCK_CALLS=500
